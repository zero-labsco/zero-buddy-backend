# LLM provider (OpenAI-compatible). Works with OpenAI, DeepSeek, Qwen, etc.
LLM_BASE_URL=https://api.openai.com/v1
# 缺失或留空则启动离线模式（直接返回检索到的知识，不调用 LLM）
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Server bind address
BIND_ADDR=127.0.0.1:3030

# CORS：允许的前端来源（逗号分隔）；设为 * 则允许任意来源
CORS_ORIGIN=http://localhost:3040

# 知识库版本：变更后使 answers_cache.json 整体失效并重建
CACHE_VERSION=v1

# 单次 LLM 调用超时（秒）
REQUEST_TIMEOUT_SECS=30

# 品牌与文案（改名只改这里，无需改代码）
PRODUCT_NAME=ZeroBuddy
ORG_NAME=Zero Labs

# 可调参数（留空则用代码默认值）
RAG_TOP_K=3
RAG_MIN_SCORE=0.2
CACHE_SIMILARITY=0.92
MAX_MESSAGE_CHARS=4000
MAX_MESSAGES=50
