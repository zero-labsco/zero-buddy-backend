# LLM provider (OpenAI-compatible). Works with OpenAI, DeepSeek, Qwen, etc.
LLM_BASE_URL=https://api.openai.com/v1
# 缺失或留空则启动离线模式（直接返回检索到的知识，不调用 LLM）
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Server bind address
BIND_ADDR=127.0.0.1:3030

# CORS：允许的前端来源（逗号分隔）；设为 * 则允许任意来源
CORS_ORIGIN=http://localhost:3040

# 知识库版本：变更后使 answers_cache.json 整体失效并重建
CACHE_VERSION=v1

# 单次 LLM 调用超时（秒）
REQUEST_TIMEOUT_SECS=30

# 品牌与文案（改名只改这里，无需改代码）
PRODUCT_NAME=ZeroBuddy
ORG_NAME=Zero Labs

# 可调参数（留空则用代码默认值）
RAG_TOP_K=3
RAG_MIN_SCORE=0.2
CACHE_SIMILARITY=0.92
MAX_MESSAGE_CHARS=4000
MAX_MESSAGES=50

# 话题范围拦截（Scope Guard）：防止被用于回答与项目无关的问题，节省 token、防滥用
# 总开关：true/false（默认 true）
SCOPE_GUARD_ENABLED=true
# 工作模式：prompt=靠 LLM 自觉遵守；hard=后端硬拦截（命中白名单才放行，省 token）
SCOPE_GUARD_MODE=prompt
# 白名单触发词（逗号分隔，大小写不敏感，子串匹配）；命中即放行。留空=全部放行
SCOPE_ALLOW_KEYWORDS=zero,zerolabs,labs,flutter agent kit,flutter,zero inspector kit,inspector,wizardplayer,invoice zero,invoice,zerobuddy,buddy,kit,sdk,api,文档,部署,配置,安装,教程,使用,功能,报价,价格,license,licence,开源,仓库,github,support,联系
# 白名单正则（竖线 | 分隔；命中即放行）：产品名变体、官网、邮箱、仓库、相关技术栈
SCOPE_ALLOW_PATTERNS=(?i)zero[\s-]?(inspector|flutter[\s-]?agent|invoice)?[\s-]?kit|(?i)wizard[\s-]?player|(?i)invoice[\s-]?zero|(?i)zero[\s-]?buddy|(?i)zerolabsco\.com|(?i)github\.com/zero-labsco|(?i)support@zerolabsco\.com|(?i)\b(dart|rust|next\.?js|react|axum|tokio|cors|llm|embedding|rag|openai)\b
# 超范围时返回的拒绝话术（可覆盖内置默认值）
# SCOPE_REFUSE_REPLY_ZH=抱歉，我只能回答与 Zero Labs 产品相关的问题……
# SCOPE_REFUSE_REPLY_EN=Sorry, I can only help with questions about Zero Labs products……

# 使用限制（防滥用 / 控成本）：按客户端 IP 计数（单实例内存计数）
# 每分钟最多请求数（0=不限制）
RATE_LIMIT_PER_MIN=10
# 每天最多请求数（0=不限制）
RATE_LIMIT_PER_DAY=500
# 触发限制时返回的提示（可覆盖内置默认值）
# RATE_LIMIT_REPLY_ZH=您请求过于频繁，请稍后再试……
# RATE_LIMIT_REPLY_EN=Too many requests. Please slow down……
